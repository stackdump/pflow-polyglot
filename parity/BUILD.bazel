# The point of the Bazel port: one `bazel test //...` that fails if any
# implementation's execution trace drifts from the others.
#
# The grid is 5 forms x 4 languages (FORMS.md). Every one of these 20 programs
# is an independent encoding of the same Petri net, run under a hermetic
# toolchain (Go SDK 1.26.0, Rust 1.86.0, Node 22.14.0, CPython 3.12), and every
# one must emit the byte-identical canonical trace.
#
# Languages outside the Bazel graph (ruby, julia, haskell, bash, solidity) are
# NOT covered by this gate — see README.md for what does cover them.

IMPLEMENTATIONS = {
    "go-interpreter": "//golang/interpreter",
    "go-lambda": "//golang/lambda",
    "go-contract": "//golang/contract",
    "go-generated": "//golang/generated",
    "go-proof": "//golang/proof",
    "rust-interpreter": "//rust:interpreter",
    "rust-lambda": "//rust:lambda",
    "rust-contract": "//rust:contract",
    "rust-generated": "//rust:generated",
    "rust-proof": "//rust:proof",
    "python-interpreter": "//python:interpreter",
    "python-lambda": "//python:lambda",
    "python-contract": "//python:contract",
    "python-generated": "//python:generated",
    "python-proof": "//python:proof",
    "js-interpreter": "//javascript:interpreter",
    "js-lambda": "//javascript:lambda",
    "js-contract": "//javascript:contract",
    "js-generated": "//javascript:generated",
    "js-proof": "//javascript:proof",
}

sh_test(
    name = "cross_language_parity_test",
    size = "small",
    srcs = ["check_parity.sh"],
    args = ["$(rootpath trace.golden)"] + [
        "{}=$(rootpath {})".format(label, target)
        for label, target in sorted(IMPLEMENTATIONS.items())
    ],
    data = ["trace.golden"] + sorted(IMPLEMENTATIONS.values()),
)

# trace.golden is referenced from tools/codegen (which derives a trace from the
# state space and diffs it against this file); reachability.golden is the state
# space itself, generated by //tools/codegen/reachability and gated by
# //tools/codegen:reachability_test.
exports_files([
    "trace.golden",
    "reachability.golden",
])
